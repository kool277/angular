{
  "projects": {
    "examples": {
      "i18n": {
        "sourceLocale": "en-US",
        "locales": {
          "uz": "src/locale/messages.uz.xlf"
        }
      },
      "architect": {
        "build": {
          "options": {
            "localize": true,
            "i18nMissingTranslation": "error"
          },
          "configurations": {
            "uz": {
              "localize": ["uz"]
            }
          }
        },
        "serve": {
          "configurations": {
            "uz": {
              "buildTarget": "examples:build:development,uz"
            }
          }
        }
      }
    }
  }
}
